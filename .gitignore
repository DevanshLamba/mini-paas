# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node (dashboard tooling, k6 helpers)
node_modules/

# Editors / OS
.vscode/
.idea/
